# Local development: leave Supabase empty to use the isolated fictional demo.
STUDIOFLOW_DEMO_MODE=true

# Production: dedicated Supabase project with migrations applied.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only secret. Never prefix this key with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Optional: 32 random bytes in base64 to encrypt the businesses' payment API keys.
# Without it the key is derived from SUPABASE_SECRET_KEY. Never prefix with NEXT_PUBLIC_.
PAYMENTS_ENCRYPTION_KEY=

# AI receptionist (server only). Never prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=

# Audio notes from WhatsApp/Instagram become text (server only). Any service
# compatible with /audio/transcriptions: OpenAI (default) or Groq, e.g.
# TRANSCRIBE_BASE_URL=https://api.groq.com/openai/v1 and TRANSCRIBE_MODEL=whisper-large-v3-turbo.
TRANSCRIBE_API_KEY=
TRANSCRIBE_BASE_URL=
TRANSCRIBE_MODEL=

# StudioFlow team WhatsApp (digits with country code) for the "Falar com o
# StudioFlow" button on the release and renewal screens. Public on purpose.
NEXT_PUBLIC_STUDIOFLOW_WHATSAPP=

# WhatsApp da loja por QR Code: servidor Evolution API (v2) do StudioFlow.
# Cada loja conecta o próprio número em Configurações → WhatsApp.
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
# Opcional: nome da instância do WhatsApp do próprio StudioFlow (lembretes de mensalidade).
EVOLUTION_PLATFORM_INSTANCE=

# Mensalidade do StudioFlow: conta Asaas da plataforma (não a das lojas).
STUDIOFLOW_ASAAS_API_KEY=
STUDIOFLOW_ASAAS_ENV=production
# Token do webhook do Asaas da plataforma → /api/billing/asaas (cabeçalho asaas-access-token).
STUDIOFLOW_ASAAS_WEBHOOK_TOKEN=
# Lembretes diários (Vercel Cron em vercel.json chama /api/cron/billing com este segredo).
CRON_SECRET=
