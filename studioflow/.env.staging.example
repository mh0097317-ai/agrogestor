# Homologação (staging) do StudioFlow. Copie para .env.staging.local e preencha.
# NUNCA use aqui as chaves do projeto de produção (dyukaebjntbfeqctyehi).
# Confira com: node scripts/staging/check-env.mjs .env.staging.local

# Marca o ambiente como homologação: o envio vira "sandbox" por padrão.
STUDIOFLOW_STAGING=1
# sandbox = só sai para os destinos da lista abaixo; off = nada sai.
STUDIOFLOW_OUTBOUND_MODE=sandbox
# Telefones (só dígitos, com DDD) e e-mails de teste, separados por vírgula.
STUDIOFLOW_OUTBOUND_ALLOWLIST=

# Supabase de homologação (projeto separado, só dados fictícios).
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO-STAGING.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# 32 bytes em base64, diferente da produção: openssl rand -base64 32
PAYMENTS_ENCRYPTION_KEY=

# Asaas só no sandbox (https://sandbox.asaas.com). Produção é bloqueada pela
# trava de envio quando o modo não é "live".
STUDIOFLOW_ASAAS_API_KEY=
STUDIOFLOW_ASAAS_ENV=sandbox
STUDIOFLOW_ASAAS_WEBHOOK_TOKEN=

# Cron: segredo próprio da homologação.
CRON_SECRET=

# IA: deixe vazio para não gastar. Com chave, use uma chave separada e com
# limite de gasto no console da Anthropic.
ANTHROPIC_API_KEY=
STUDIOFLOW_ASSISTANT_ENGINE=v3

# WhatsApp por QR: instância de teste com número de teste, nunca o da loja.
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_PLATFORM_INSTANCE=sf-staging

# E-mail: vazio = não envia.
RESEND_API_KEY=

NEXT_PUBLIC_APP_URL=http://localhost:3000
