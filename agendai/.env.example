# Banco de dados (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/agendai"

# Segredo para assinar a sessão (gere com: openssl rand -base64 32)
AUTH_SECRET="troque-isto-por-um-segredo-longo"

# URL pública do app (usada nos links enviados aos clientes)
APP_URL="http://localhost:3000"

# Segredo do endpoint de lembretes automáticos (/api/cron/lembretes)
CRON_SECRET="troque-isto"

# ---------------- Notificações (todas opcionais) ----------------
# Sem nenhuma configuração, as mensagens ficam registradas no painel como
# "simuladas" e o dono ainda pode enviar pelo WhatsApp com 1 clique (wa.me).

# WhatsApp via Z-API (https://z-api.io)
ZAPI_INSTANCE_ID=""
ZAPI_TOKEN=""
ZAPI_CLIENT_TOKEN=""

# WhatsApp via Twilio (alternativa)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM=""   # ex.: whatsapp:+14155238886

# E-mail via Resend (https://resend.com)
RESEND_API_KEY=""
EMAIL_FROM="Agendaí <agenda@seudominio.com.br>"
